#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
flow_dir="$(cd "$script_dir/.." && pwd)"
if ! repo_root="$(git -C "$flow_dir" rev-parse --show-toplevel 2>/dev/null)"; then
  repo_root="$(cd "$flow_dir/.." && pwd)"
fi
config_file="$flow_dir/config.env"

config_value() {
  local key="$1" fallback="$2" value=''
  if [[ -f "$config_file" ]]; then
    value="$(sed -n "s/^[[:space:]]*${key}[[:space:]]*=[[:space:]]*//p" "$config_file" | tail -n 1)"
    value="${value%$'\r'}"
    if [[ "$value" == \"*\" || "$value" == \'*\' ]]; then
      value="${value:1:${#value}-2}"
    fi
    if [[ "$value" =~ ^\$\{[A-Z0-9_]+:-([^}]*)\}$ ]]; then
      value="${BASH_REMATCH[1]}"
    fi
  fi
  printf '%s' "${value:-$fallback}"
}

slice_budget="${AGENT_FLOW_SLICE_BUDGET:-$(config_value AGENT_FLOW_SLICE_BUDGET 300)}"
pr_budget="${AGENT_FLOW_PR_BUDGET:-$(config_value AGENT_FLOW_PR_BUDGET 1800)}"
file_budget="${AGENT_FLOW_PRODUCTION_FILE_BUDGET:-$(config_value AGENT_FLOW_PRODUCTION_FILE_BUDGET 5)}"
default_diff="${AGENT_FLOW_DEFAULT_DIFF:-$(config_value AGENT_FLOW_DEFAULT_DIFF HEAD)}"

die() {
  printf 'ошибка: %s\n' "$*" >&2
  exit 1
}

validate_integer() {
  [[ "$2" =~ ^[0-9]+$ ]] || die "$1 должен быть целым неотрицательным числом, получено: $2"
}

usage() {
  printf '%s\n' \
    'Использование: .agent-flow/bin/flow <команда> [аргументы]' \
    '' \
    'Команды:' \
    '  setup-local        Локально исключить flow-файлы через .git/info/exclude' \
    '  new <slug>         Создать task-папку из шаблонов' \
    '  status             Показать состояния задач' \
    '  budget [git-range] Классифицировать и посчитать изменённые строки (по умолчанию HEAD)' \
    '  budget-task [base] Информационный размер всей задачи/PR' \
    '  validate           Проверить файлы flow, состояния и обязательные gates' \
    '  help               Показать эту справку'
}

setup_local() {
  git -C "$repo_root" rev-parse --git-dir >/dev/null 2>&1 || die 'setup-local требует Git-репозиторий'

  local exclude_path pattern tracked
  exclude_path="$(git -C "$repo_root" rev-parse --git-path info/exclude)"
  if [[ "$exclude_path" != /* ]]; then
    exclude_path="$repo_root/$exclude_path"
  fi

  mkdir -p "$(dirname "$exclude_path")"
  touch "$exclude_path"

  if ! grep -Fqx '# Agent Context Flow: local-only files' "$exclude_path"; then
    printf '\n# Agent Context Flow: local-only files\n' >> "$exclude_path"
  fi
  for pattern in '/AGENTS.md' '/.agent-flow/'; do
    if ! grep -Fqx "$pattern" "$exclude_path"; then
      printf '%s\n' "$pattern" >> "$exclude_path"
    fi
  done

  printf 'Flow-файлы локально исключены через %s\n' "$exclude_path"

  tracked="$(git -C "$repo_root" ls-files -- AGENTS.md .agent-flow)"
  if [[ -n "$tracked" ]]; then
    printf '%s\n' \
      'ПРЕДУПРЕЖДЕНИЕ: некоторые flow-файлы уже находятся в Git index:' \
      "$tracked" \
      'Index не был изменён автоматически.' \
      'После проверки их можно удалить только из index командой:' \
      '  git rm -r --cached -- AGENTS.md .agent-flow' >&2
  fi
}

new_task() {
  [[ $# -eq 1 ]] || die 'new ожидает один короткий slug, например: add-payment-retry'
  local raw_slug="$1"
  local slug
  slug="$(printf '%s' "$raw_slug" | tr '[:upper:]_' '[:lower:]-' | tr -cd 'a-z0-9-' | sed 's/--*/-/g; s/^-//; s/-$//')"
  [[ -n "$slug" ]] || die 'slug должен содержать латинские буквы или цифры'

  local created_at task_id destination template target temporary
  created_at="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  task_id="$(date -u '+%Y%m%d-%H%M%S')-$slug"
  destination="$flow_dir/tasks/$task_id"
  [[ ! -e "$destination" ]] || die "задача уже существует: $destination"

  mkdir -p "$destination/decisions"
  for template in "$flow_dir/templates/task/"*.md; do
    target="$destination/$(basename "$template")"
    temporary="$target.tmp.$$"
    awk -v task_id="$task_id" -v created_at="$created_at" '
      { gsub(/__TASK_ID__/, task_id); gsub(/__CREATED_AT__/, created_at); print }
    ' "$template" > "$temporary"
    mv "$temporary" "$target"
  done

  printf 'Создано: %s\n' "$destination"
  printf 'Далее: заполнить %s/brief.md и следовать WORKFLOW.md\n' "$destination"
}

show_status() {
  local found=0 brief task state
  for brief in "$flow_dir/tasks/"*/brief.md; do
    [[ -e "$brief" ]] || continue
    found=1
    task="$(basename "$(dirname "$brief")")"
    state="$(sed -n \
      -e 's/^- Состояние: `\([^`]*\)`.*/\1/p' \
      -e 's/^- State: `\([^`]*\)`.*/\1/p' \
      "$brief" | head -n 1)"
    [[ -n "$state" ]] || state='UNKNOWN'
    printf '%-48s %s\n' "$task" "$state"
  done
  [[ $found -eq 1 ]] || printf 'Записи задач не найдены.\n'
}

# ls-tree metadata is ASCII; paths are literal and may contain tabs/newlines.
tree_signature() {
  local entry
  entry="$(git -C "$repo_root" --literal-pathspecs ls-tree "$1" -- "$2")" || return
  printf '%s' "${entry%%$'\t'*}"
}

show_budget() (
  # Subshell confines the temporary-file trap and arrays to this invocation.
  local diff_range="${1:-$default_diff}" mode="${2:-slice}"
  validate_integer AGENT_FLOW_SLICE_BUDGET "$slice_budget"
  validate_integer AGENT_FLOW_PR_BUDGET "$pr_budget"
  validate_integer AGENT_FLOW_PRODUCTION_FILE_BUDGET "$file_budget"
  [[ "$diff_range" != -* ]] || die 'git-range не может начинаться с дефиса'
  git -C "$repo_root" rev-parse --git-dir >/dev/null 2>&1 || die 'budget требует Git-репозиторий'

  local base="$diff_range" target='' left right
  case "$diff_range" in
    *...*)
      left="${diff_range%%...*}"; right="${diff_range#*...}"
      base="$(git -C "$repo_root" merge-base "${left:-HEAD}" "${right:-HEAD}")" || die 'не удалось определить merge-base'
      target="${right:-HEAD}" ;;
    *..*) base="${diff_range%%..*}"; target="${diff_range#*..}"
      base="${base:-HEAD}"; target="${target:-HEAD}" ;;
  esac
  base="$(git -C "$repo_root" rev-parse --verify "$base^{commit}")" || die 'неверный baseline'
  local scratch
  scratch="$(mktemp -d)" || die 'не удалось создать временный каталог'
  trap 'rm -rf -- "$scratch"' EXIT
  local args=("$base")
  [[ -z "$target" ]] || args+=("$target")
  git -C "$repo_root" diff --no-ext-diff --no-textconv --no-renames --numstat -z "${args[@]}" -- . > "$scratch/stats" || die 'git diff завершился ошибкой'
  local paths=() adds=() dels=() old=() current=() paired=()
  local record path rest count=0 i j signature absolute hash file_mode
  while IFS= read -r -d '' record; do
    adds[$count]="${record%%$'\t'*}"
    rest="${record#*$'\t'}"
    dels[$count]="${rest%%$'\t'*}"
    paths[$count]="${rest#*$'\t'}"
    count=$((count + 1))
  done < "$scratch/stats"
  if [[ -z "$target" ]]; then
    git -C "$repo_root" ls-files --others --exclude-standard -z > "$scratch/untracked" || die 'не удалось прочитать untracked-файлы'
    while IFS= read -r -d '' path; do
      absolute="$repo_root/$path"
      [[ -f "$absolute" || -L "$absolute" ]] || continue
      paths[$count]="$path"; dels[$count]=0
      if [[ -L "$absolute" ]]; then
        adds[$count]='-'
      elif [[ ! -s "$absolute" ]] || LC_ALL=C grep -Iq . "$absolute"; then
        adds[$count]="$(awk 'END { print NR + 0 }' "$absolute")"
      else
        adds[$count]='-'
      fi
      count=$((count + 1))
    done < "$scratch/untracked"
  fi
  local filemode
  filemode="$(git -C "$repo_root" config --get core.filemode || true)"
  for ((i=0; i<count; i++)); do
    path="${paths[$i]}"; paired[$i]=0
    old[$i]="$(tree_signature "$base" "$path")" || die 'не удалось прочитать baseline tree'
    current[$i]=''
    if [[ -n "$target" ]]; then
      current[$i]="$(tree_signature "$target" "$path")" || die 'не удалось прочитать target tree'
    else
      absolute="$repo_root/$path"
      if [[ -L "$absolute" ]]; then
        current[$i]='special'
      elif [[ -f "$absolute" ]]; then
        hash="$(git -C "$repo_root" hash-object --no-filters -- "$absolute")" || die 'не удалось вычислить blob файла'
        file_mode=100644
        if [[ "$filemode" != false && -x "$absolute" ]]; then file_mode=100755; fi
        current[$i]="$file_mode blob $hash"
      elif [[ -e "$absolute" ]]; then
        current[$i]='special'
      fi
    fi
  done
  local moves=0
  for ((i=0; i<count; i++)); do
    [[ -z "${current[$i]}" && "${old[$i]}" == 100???\ blob\ * ]] || continue
    for ((j=0; j<count; j++)); do
      if [[ "${paired[$j]}" == 0 && -z "${old[$j]}" && "${current[$j]}" == "${old[$i]}" ]]; then
        paired[$i]=1; paired[$j]=1; moves=$((moves + 1))
        printf 'Чистый перенос: %q -> %q\n' "${paths[$i]}" "${paths[$j]}"
        break
      fi
    done
  done
  local production=0 production_files=0 tests=0 test_files=0 generated=0 generated_files=0 workflow=0 workflow_files=0 binaries=0 changed a d
  for ((i=0; i<count; i++)); do
    [[ "${paired[$i]}" == 0 ]] || continue
    path="${paths[$i]}"; a="${adds[$i]}"; d="${dels[$i]}"
    if [[ "$a" == '-' || "$d" == '-' ]]; then binaries=$((binaries + 1)); fi
    [[ "$a" != '-' ]] || a=0
    [[ "$d" != '-' ]] || d=0
    changed=$((a + d))
    if [[ "$path" == .agent-flow/* || "$path" == AGENTS.md ]]; then
      workflow=$((workflow + changed)); workflow_files=$((workflow_files + 1))
    elif [[ "$path" =~ (^|/)(generated|dist|build|vendor)(/|$) || "$path" =~ (^|/)(package-lock\.json|pnpm-lock\.yaml|yarn\.lock|go\.sum|Cargo\.lock)$ ]]; then
      generated=$((generated + changed)); generated_files=$((generated_files + 1))
    elif [[ "$path" =~ (^|/)(test|tests|spec|specs|__tests__|fixtures)(/|$) || "$path" =~ (_test|\.test|\.spec)\.[^./]+$ ]]; then
      tests=$((tests + changed)); test_files=$((test_files + 1))
    else
      production=$((production + changed)); production_files=$((production_files + 1))
    fi
  done
  printf 'Production-код: %d строк в %d файлах\n' "$production" "$production_files"
  printf 'Тесты:          %d строк в %d файлах\n' "$tests" "$test_files"
  printf 'Сгенерированное: %d строк в %d файлах\n' "$generated" "$generated_files"
  printf 'Документы flow:  %d строк в %d файлах\n' "$workflow" "$workflow_files"
  printf 'Чистые переносы: %d (вне LOC и лимита файлов; требуется ревью путей)\n' "$moves"
  printf 'Бинарные/нетекстовые изменения: %d (LOC не измерен)\n' "$binaries"
  if [[ "$mode" == task ]]; then
    printf 'Ориентир задачи/PR: %d строк production-кода\n' "$pr_budget"
    if (( production > pr_budget )); then
      printf 'ИНФОРМАЦИЯ: превышен ориентир задачи/PR; лимиты slice здесь не применяются\n'
    fi
    printf 'РЕЗУЛЬТАТ: информационный отчёт задачи; бюджет slice проверяется отдельно\n'
  else
    printf 'Бюджет этапа: %d строк / %d production-файлов\n' "$slice_budget" "$file_budget"
    if (( production > slice_budget || production_files > file_budget )); then
      printf 'РЕЗУЛЬТАТ: превышен бюджет этапа; остановитесь для решения человека\n'
      exit 2
    fi
    printf 'РЕЗУЛЬТАТ: изменение укладывается в стандартный бюджет этапа\n'
  fi
)

task_state_from() {
  sed -n \
    -e 's/^- Состояние: `\([^`]*\)`.*/\1/p' \
    -e 's/^- State: `\([^`]*\)`.*/\1/p' \
    "$1" | head -n 1
}

valid_task_state() {
  case "$1" in
    INTAKE|DISCOVERY|WAIT_PLAN_APPROVAL|WAIT_SLICE_APPROVAL|VERIFYING|\
      WAIT_FINAL_HUMAN_REVIEW|CONTEXT_HANDOFF|BLOCKED|DONE|ABANDONED)
      return 0
      ;;
  esac
  [[ "$1" =~ ^IMPLEMENTING_SLICE_[1-9][0-9]*$ ]]
}

# Exactly one complete Markdown field is required; missing/duplicate fields fail.
markdown_field() {
  [[ -s "$1" ]] || return 0
  awk -v key="$2" '
    { sub(/\r$/, "") }
    index($0, "- " key ":") == 1 {
      count++
      prefix = "- " key ": `"
      if (index($0, prefix) == 1 && $0 ~ /`[ \t]*$/) {
        value = substr($0, length(prefix) + 1)
        sub(/`[ \t]*$/, "", value)
        if (index(value, "`") != 0) value = ""
      }
    }
    END { if (count == 1) print value }
  ' "$1"
}

filled_field() {
  local value
  value="$(markdown_field "$1" "$2")"
  case "$value" in
    ''|NOT_APPROVED|NOT_REVIEWED|UNKNOWN|НЕИЗВЕСТНО|НЕТ|NONE|N/A|REJECTED) return 1 ;;
  esac
  [[ "$value" =~ [^[:space:]] ]]
}

checks_complete() {
  local status
  status="$(markdown_field "$1" 'Обязательные проверки')"
  [[ "$status" == PASSED ]] ||
    { [[ "$status" == APPROVED_EXCEPTION ]] && filled_field "$1" 'Исключение по проверкам'; }
}

handoff_complete() {
  local choice risk
  [[ "$(markdown_field "$1" 'Результат')" == IMPLEMENTED ]] || return 1
  [[ "$(markdown_field "$1" 'Краткое резюме передано')" == ДА ]] || return 1
  risk="$(markdown_field "$1" 'Режим задачи')"
  case "$risk" in QUICK|GUIDED|MECHANICAL|CRITICAL) ;; *) return 1 ;; esac
  [[ "$risk" == "$(markdown_field "$2" 'Режим риска')" ]] || return 1
  choice="$(markdown_field "$1" 'Выбор человека')"
  case "$choice" in
    КОНТЕКСТА_ДОСТАТОЧНО) ;;
    РАЗОБРАТЬ_ПОТОК) [[ "$(markdown_field "$1" 'Разбор потока проведён')" == ДА ]] || return 1 ;;
    РАЗОБРАТЬ_ДИАГНОСТИКУ) [[ "$(markdown_field "$1" 'Разбор диагностики и отката проведён')" == ДА ]] || return 1 ;;
    *) return 1 ;;
  esac
  [[ "$risk" != CRITICAL || "$(markdown_field "$1" 'Разбор диагностики и отката проведён')" == ДА ]]
}

validate_flow() {
  local required=(
    "$repo_root/AGENTS.md"
    "$flow_dir/README.md"
    "$flow_dir/PROJECT.md"
    "$flow_dir/POLICY.md"
    "$flow_dir/WORKFLOW.md"
    "$flow_dir/HUMAN_REVIEW.md"
    "$flow_dir/CONTEXT_HANDOFF.md"
    "$flow_dir/REFERENCES.md"
    "$flow_dir/config.env"
    "$flow_dir/bin/flow"
    "$flow_dir/bin/flow.ps1"
    "$flow_dir/prompts/bootstrap.md"
    "$flow_dir/prompts/debug.md"
    "$flow_dir/prompts/finalize.md"
    "$flow_dir/prompts/new-feature.md"
    "$flow_dir/prompts/resume.md"
    "$flow_dir/prompts/review-slice.md"
    "$flow_dir/tasks/README.md"
    "$flow_dir/templates/decision.md"
    "$flow_dir/templates/pr-description.md"
    "$flow_dir/templates/task/brief.md"
    "$flow_dir/templates/task/discovery.md"
    "$flow_dir/templates/task/final-review.md"
    "$flow_dir/templates/task/handoff.md"
    "$flow_dir/templates/task/plan.md"
    "$flow_dir/templates/task/progress.md"
  )
  local item issues=0 warnings=0 task_file task_dir brief_state progress_state
  for item in "${required[@]}"; do
    if [[ ! -s "$item" ]]; then
      printf 'ОТСУТСТВУЕТ %s\n' "$item" >&2
      issues=1
    fi
  done

  for task_dir in "$flow_dir/tasks/"*/; do
    [[ -d "$task_dir" ]] || continue
    [[ "$(basename "$task_dir")" == 'tasks' ]] && continue
    for task_file in brief.md discovery.md plan.md progress.md handoff.md; do
      if [[ ! -s "$task_dir/$task_file" ]]; then
        printf 'ОТСУТСТВУЕТ %s\n' "$task_dir/$task_file" >&2
        issues=1
      fi
    done
    if [[ ! -s "$task_dir/final-review.md" ]]; then
      if [[ -s "$task_dir/review.md" ]]; then
        printf 'УСТАРЕВШИЙ ФОРМАТ %s (создайте final-review.md перед финальной приёмкой)\n' \
          "${task_dir%/}/review.md" >&2
      else
        printf 'ОТСУТСТВУЕТ %s\n' "${task_dir%/}/final-review.md" >&2
        issues=1
      fi
    fi

    if grep -R -q -F -e '__TASK_ID__' -e '__CREATED_AT__' "$task_dir"; then
      printf 'НЕЗАМЕНЁННЫЙ МАРКЕР ШАБЛОНА %s\n' "${task_dir%/}" >&2
      issues=1
    fi

    [[ -s "$task_dir/brief.md" && -s "$task_dir/progress.md" ]] || continue
    brief_state="$(task_state_from "$task_dir/brief.md")"
    progress_state="$(task_state_from "$task_dir/progress.md")"

    if [[ -z "$brief_state" ]] || ! valid_task_state "$brief_state"; then
      printf 'НЕДОПУСТИМОЕ СОСТОЯНИЕ %s: %s\n' \
        "${task_dir%/}/brief.md" "${brief_state:-ОТСУТСТВУЕТ}" >&2
      issues=1
      continue
    fi
    if [[ -z "$progress_state" ]] || ! valid_task_state "$progress_state"; then
      printf 'НЕДОПУСТИМОЕ СОСТОЯНИЕ %s: %s\n' \
        "${task_dir%/}/progress.md" "${progress_state:-ОТСУТСТВУЕТ}" >&2
      issues=1
      continue
    fi
    if [[ "$brief_state" != "$progress_state" ]]; then
      printf 'РАССИНХРОНИЗАЦИЯ СОСТОЯНИЯ %s: brief=%s, progress=%s\n' \
        "${task_dir%/}" "$brief_state" "$progress_state" >&2
      issues=1
    fi

    case "$brief_state" in
      IMPLEMENTING_SLICE_*|WAIT_SLICE_APPROVAL|VERIFYING|WAIT_FINAL_HUMAN_REVIEW|\
        CONTEXT_HANDOFF|DONE)
        if [[ "$(markdown_field "$task_dir/plan.md" 'Состояние')" != APPROVED ]] ||
          ! filled_field "$task_dir/plan.md" 'Согласовал' ||
          [[ ! "$(markdown_field "$task_dir/plan.md" 'Дата согласования')" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}($|T) ]]; then
          printf 'НЕ ПРИНЯТ ПЛАН %s\n' "${task_dir%/}/plan.md" >&2
          issues=1
        fi
        ;;
    esac

    case "$brief_state" in
      WAIT_FINAL_HUMAN_REVIEW|CONTEXT_HANDOFF|DONE)
        if [[ "$(markdown_field "$task_dir/final-review.md" 'Состояние')" != READY ]]; then
          printf 'НЕ ГОТОВ ПАКЕТ ФИНАЛЬНОГО РЕВЬЮ %s\n' "${task_dir%/}/final-review.md" >&2
          issues=1
        fi
        ;;
    esac

    case "$brief_state" in
      CONTEXT_HANDOFF|DONE)
        if [[ "$(markdown_field "$task_dir/final-review.md" 'Решение человека')" != APPROVED ]]; then
          printf 'НЕ ПРИНЯТО ФИНАЛЬНОЕ РЕВЬЮ %s\n' "${task_dir%/}/final-review.md" >&2
          issues=1
        fi
        if ! checks_complete "$task_dir/final-review.md"; then
          printf 'НЕ ЗАВЕРШЕНЫ ОБЯЗАТЕЛЬНЫЕ ПРОВЕРКИ %s\n' "${task_dir%/}/final-review.md" >&2
          issues=1
        fi
        ;;
    esac

    if [[ "$brief_state" == DONE ]] && ! handoff_complete "$task_dir/handoff.md" "$task_dir/brief.md"; then
      printf 'НЕ ЗАВЕРШЕНА ПЕРЕДАЧА КОНТЕКСТА %s\n' "${task_dir%/}/handoff.md" >&2
      issues=1
    fi
  done

  validate_integer AGENT_FLOW_SLICE_BUDGET "$slice_budget"
  validate_integer AGENT_FLOW_PR_BUDGET "$pr_budget"
  validate_integer AGENT_FLOW_PRODUCTION_FILE_BUDGET "$file_budget"
  if [[ -s "$flow_dir/PROJECT.md" ]] &&
    grep -Fq 'Статус: `NOT_INITIALIZED`' "$flow_dir/PROJECT.md"; then
    printf 'ПРЕДУПРЕЖДЕНИЕ: PROJECT.md ещё не инициализирован.\n' >&2
    warnings=1
  fi
  [[ $issues -eq 0 ]] || exit 1
  if [[ $warnings -eq 1 ]]; then
    printf 'Структура и состояния flow корректны; есть предупреждения.\n'
  else
    printf 'Структура и состояния flow корректны.\n'
  fi
}

command="${1:-help}"
shift || true
case "$command" in
  setup-local) [[ $# -eq 0 ]] || die 'setup-local не принимает аргументы'; setup_local ;;
  new) new_task "$@" ;;
  status) [[ $# -eq 0 ]] || die 'status не принимает аргументы'; show_status ;;
  budget) [[ $# -le 1 ]] || die 'budget принимает не более одного Git-диапазона'; show_budget "${1:-}" ;;
  budget-task) [[ $# -le 1 ]] || die 'budget-task принимает не более одного Git-диапазона'; show_budget "${1:-}" task ;;
  validate) [[ $# -eq 0 ]] || die 'validate не принимает аргументы'; validate_flow ;;
  help|-h|--help) usage ;;
  *) die "неизвестная команда: $command" ;;
esac
